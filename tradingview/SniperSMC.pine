//@version=5
// =============================================================================
// AI-ETH-trade · Sniper SMC + VWAP + VSA + EQH/EQL
// Original work. Combines market structure (BOS/CHoCH), equal highs/lows &
// liquidity sweeps, Fair Value Gaps, session VWAP with std-dev bands, and
// Volume Spread Analysis into a confluence-scored long/short signal.
//
// Fires alert() with JSON matching the AI-ETH-trade bot webhook:
//   POST /webhook/tradingview
// Set ONE alert on this indicator -> "Any alert() function call" -> Webhook URL.
// =============================================================================
indicator("Sniper SMC + VWAP + VSA", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ------------------------------------------------------------------- Inputs --
grpMS   = "Market Structure"
swingLen = input.int(10, "Swing Pivot Length", minval = 2, group = grpMS)
showSwings = input.bool(true, "Show HH / HL / LH / LL", group = grpMS)
showMS   = input.bool(true, "Show BMS / CHoCH", group = grpMS)

grpLiq  = "Liquidity (EQH / EQL & Sweeps)"
eqTolMult = input.float(0.10, "Equal H/L tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpLiq)
showEq    = input.bool(true, "Show EQH / EQL", group = grpLiq)
showSweep = input.bool(true, "Show liquidity sweeps", group = grpLiq)

grpFVG  = "Fair Value Gaps & Order Blocks"
showFVG   = input.bool(true, "Show FVGs", group = grpFVG)
showOB    = input.bool(true, "Show order blocks", group = grpFVG)
maxFVG    = input.int(8, "Max FVGs / OBs kept per side", minval = 1, maxval = 30, group = grpFVG)
fvgExtend = input.int(20, "FVG / OB extend (bars)", minval = 1, group = grpFVG)

grpVwap = "VWAP"
showVwap  = input.bool(true, "Show VWAP + bands", group = grpVwap)
vwapAnchor = input.string("Daily", "Anchor", options = ["Daily", "Weekly"], group = grpVwap)
bandMult  = input.float(2.0, "Band std-dev multiplier", minval = 0.5, step = 0.5, group = grpVwap)

grpVol  = "Volume / VSA"
volLen    = input.int(20, "Volume average length", minval = 2, group = grpVol)
highVolX  = input.float(1.5, "High-volume threshold (× avg)", step = 0.1, group = grpVol)
climaxX   = input.float(2.5, "Climax-volume threshold (× avg)", step = 0.1, group = grpVol)
colorVol  = input.bool(false, "Colour volume-significant bars", group = grpVol)
showVSA   = input.bool(false, "Show VSA markers on price (VSA lives in the Volume pane)", group = grpVol)

grpSig  = "Signals & Risk"
scoreThreshold = input.int(60, "Min confluence to signal (0-100)", minval = 0, maxval = 100, group = grpSig)
minRR    = input.float(2.0, "Min Risk:Reward", minval = 0.5, step = 0.1, group = grpSig)
stopBufX = input.float(0.20, "Stop buffer (× ATR)", step = 0.05, group = grpSig)
cooldown = input.int(5, "Min bars between signals", minval = 0, group = grpSig)
showSignals = input.bool(false, "Show LONG / SHORT signals (and fire bot alerts)", group = grpSig)

grpHook = "Webhook (AI-ETH-trade bot)"
whSecret = input.string("", "Webhook secret", group = grpHook)
whSymbol = input.string("ETHUSDT", "Bot symbol", group = grpHook)

// --------------------------------------------------------------- Foundations --
atr = ta.atr(200)
atrOk = not na(atr) and atr > 0

// ------------------------------------------------------ Market structure -----
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var float resistance = na
var bool  resBroken  = true
var float support    = na
var bool  supBroken  = true
var int   trend      = 0   // 1 bullish, -1 bearish, 0 undecided
var int   resBar     = na
var int   supBar     = na

// --- Alternating zig-zag structure -------------------------------------------
// A swing high is confirmed only when price turns down into a low (and a low
// only when price turns up), so swings strictly alternate H-L-H-L. Each leg
// keeps only its extreme, and every confirmed swing is compared to the last
// confirmed swing of the SAME type -> correct HH / HL / LH / LL.
var int   legDir      = 0    // 1 = up leg (tracking a high), -1 = down leg
var float legExt      = na   // running extreme of the current leg
var int   legExtBar   = na
var float lastHigh    = na   // last confirmed swing high
var int   lastHighBar = na
var float lastLow     = na   // last confirmed swing low
var int   lastLowBar  = na

bool  newHigh = false
bool  newLow  = false
float confHighP = na
int   confHighB = na
float confLowP  = na
int   confLowB  = na

if not na(ph)
    if legDir == 1
        if na(legExt) or ph > legExt
            legExt := ph
            legExtBar := bar_index - swingLen
    else
        if legDir == -1 and not na(legExt)
            confLowP := legExt
            confLowB := legExtBar
            newLow := true
        legDir := 1
        legExt := ph
        legExtBar := bar_index - swingLen

if not na(pl)
    if legDir == -1
        if na(legExt) or pl < legExt
            legExt := pl
            legExtBar := bar_index - swingLen
    else
        if legDir == 1 and not na(legExt)
            confHighP := legExt
            confHighB := legExtBar
            newHigh := true
        legDir := -1
        legExt := pl
        legExtBar := bar_index - swingLen

if newHigh
    bool isHH = not na(lastHigh) and confHighP > lastHigh
    if showEq and atrOk and not na(lastHigh) and math.abs(confHighP - lastHigh) <= eqTolMult * atr
        line.new(lastHighBar, lastHigh, confHighB, confHighP, color = color.new(color.orange, 0), style = line.style_dotted, width = 1)
        label.new(confHighB, confHighP, "EQH", style = label.style_none, textcolor = color.orange, size = size.tiny)
    if showSwings
        label.new(confHighB, confHighP, "", style = label.style_circle, color = color.new(color.red, 0), size = size.tiny)
        label.new(confHighB, confHighP, isHH ? "HH" : "LH", style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.white, size = size.small)
    lastHigh := confHighP
    lastHighBar := confHighB
    lastSwingHigh := confHighP
    resistance := confHighP
    resBar := confHighB
    resBroken := false

if newLow
    bool isHL = not na(lastLow) and confLowP > lastLow
    if showEq and atrOk and not na(lastLow) and math.abs(confLowP - lastLow) <= eqTolMult * atr
        line.new(lastLowBar, lastLow, confLowB, confLowP, color = color.new(color.blue, 0), style = line.style_dotted, width = 1)
        label.new(confLowB, confLowP, "EQL", style = label.style_none, textcolor = color.blue, size = size.tiny)
    if showSwings
        label.new(confLowB, confLowP, "", style = label.style_circle, color = color.new(color.green, 0), size = size.tiny)
        label.new(confLowB, confLowP, isHL ? "HL" : "LL", style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.white, size = size.small)
    lastLow := confLowP
    lastLowBar := confLowB
    lastSwingLow := confLowP
    support := confLowP
    supBar := confLowB
    supBroken := false

// Breaks -> BOS (with trend) or CHoCH (against trend)
bool bosUp = false
bool chochUp = false
bool bosDn = false
bool chochDn = false
if not na(resistance) and not resBroken and close > resistance
    resBroken := true
    if trend < 0
        chochUp := true
    else
        bosUp := true
    trend := 1
if not na(support) and not supBroken and close < support
    supBroken := true
    if trend > 0
        chochDn := true
    else
        bosDn := true
    trend := -1

if showMS
    if (bosUp or chochUp) and not na(resBar)
        line.new(resBar, resistance, bar_index, resistance, color = color.new(chochUp ? color.orange : color.teal, 0), style = line.style_dashed, width = 1)
        label.new(bar_index, resistance, chochUp ? "CHoCH" : "BMS", style = label.style_none, textcolor = chochUp ? color.orange : color.teal, size = size.small)
    if (bosDn or chochDn) and not na(supBar)
        line.new(supBar, support, bar_index, support, color = color.new(chochDn ? color.orange : color.maroon, 0), style = line.style_dashed, width = 1)
        label.new(bar_index, support, chochDn ? "CHoCH" : "BMS", style = label.style_none, textcolor = chochDn ? color.orange : color.teal, size = size.small)

// (EQH / EQL are drawn inline above, when a confirmed swing equals the prior one.)

// ------------------------------------------------------- Order blocks --------
// The last opposing candle before a structure break is the order block: the
// last down candle before a bullish BOS/CHoCH (demand), the last up candle
// before a bearish break (supply).
var int   obDownBar = na
var float obDownHi  = na
var float obDownLo  = na
var int   obUpBar   = na
var float obUpHi    = na
var float obUpLo    = na
if close < open
    obDownBar := bar_index
    obDownHi  := high
    obDownLo  := low
else if close > open
    obUpBar := bar_index
    obUpHi  := high
    obUpLo  := low

var array<box> bullOBs = array.new<box>()
var array<box> bearOBs = array.new<box>()
if showOB and (bosUp or chochUp) and not na(obDownBar)
    ob = box.new(obDownBar, obDownHi, bar_index + fvgExtend, obDownLo, border_color = color.new(color.teal, 20), bgcolor = color.new(color.teal, 82))
    array.push(bullOBs, ob)
    if array.size(bullOBs) > maxFVG
        box.delete(array.shift(bullOBs))
if showOB and (bosDn or chochDn) and not na(obUpBar)
    ob = box.new(obUpBar, obUpHi, bar_index + fvgExtend, obUpLo, border_color = color.new(color.maroon, 20), bgcolor = color.new(color.maroon, 82))
    array.push(bearOBs, ob)
    if array.size(bearOBs) > maxFVG
        box.delete(array.shift(bearOBs))

// ---------------------------------------------------- Liquidity sweeps -------
// Buy-side sweep: wick takes prior swing high but closes back below (traps longs)
// Sell-side sweep: wick takes prior swing low but closes back above (traps shorts)
bool sweepBuySide  = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bool sweepSellSide = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow
if showSweep and sweepBuySide
    label.new(bar_index, high, "×", style = label.style_label_down, color = color.new(color.red, 40), textcolor = color.white, size = size.tiny, tooltip = "Buy-side liquidity swept")
if showSweep and sweepSellSide
    label.new(bar_index, low, "×", style = label.style_label_up, color = color.new(color.green, 40), textcolor = color.white, size = size.tiny, tooltip = "Sell-side liquidity swept")

// -------------------------------------------------------- Fair Value Gaps ----
var array<box> bullFVGs = array.new<box>()
var array<box> bearFVGs = array.new<box>()

bool bullFVG = low > high[2]
bool bearFVG = high < low[2]

if showFVG and bullFVG
    b = box.new(bar_index - 2, low, bar_index + fvgExtend, high[2], border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
    array.push(bullFVGs, b)
    if array.size(bullFVGs) > maxFVG
        box.delete(array.shift(bullFVGs))
if showFVG and bearFVG
    b = box.new(bar_index - 2, low[2], bar_index + fvgExtend, high, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
    array.push(bearFVGs, b)
    if array.size(bearFVGs) > maxFVG
        box.delete(array.shift(bearFVGs))

// Mitigation: fade a gap once price trades back into it. Track "unmitigated".
bool bullFvgUnmitigated = false
if array.size(bullFVGs) > 0
    for i = 0 to array.size(bullFVGs) - 1
        bx = array.get(bullFVGs, i)
        if low <= box.get_top(bx)
            box.set_bgcolor(bx, color.new(color.gray, 90))
        else
            bullFvgUnmitigated := true
bool bearFvgUnmitigated = false
if array.size(bearFVGs) > 0
    for i = 0 to array.size(bearFVGs) - 1
        bx = array.get(bearFVGs, i)
        if high >= box.get_bottom(bx)
            box.set_bgcolor(bx, color.new(color.gray, 90))
        else
            bearFvgUnmitigated := true

// ------------------------------------------------------------------- VWAP ----
anchorTf = vwapAnchor == "Weekly" ? "W" : "D"
bool newPeriod = ta.change(time(anchorTf)) != 0
var float sumPV  = 0.0
var float sumV   = 0.0
var float sumPV2 = 0.0
if newPeriod
    sumPV  := 0.0
    sumV   := 0.0
    sumPV2 := 0.0
src = hlc3
sumPV  += src * volume
sumV   += volume
sumPV2 += src * src * volume
float vwap = sumV > 0 ? sumPV / sumV : na
float variance = sumV > 0 ? math.max(sumPV2 / sumV - vwap * vwap, 0.0) : 0.0
float vdev = math.sqrt(variance)
float vwUpper = vwap + bandMult * vdev
float vwLower = vwap - bandMult * vdev

plot(showVwap ? vwap : na, "VWAP", color = color.new(color.yellow, 0), linewidth = 2)
plot(showVwap ? vwUpper : na, "VWAP Upper", color = color.new(color.yellow, 55))
plot(showVwap ? vwLower : na, "VWAP Lower", color = color.new(color.yellow, 55))

bool vwapReclaimUp = not na(vwap) and ta.crossover(close, vwap)
bool vwapReclaimDn = not na(vwap) and ta.crossunder(close, vwap)
bool aboveVwap = not na(vwap) and close > vwap
bool belowVwap = not na(vwap) and close < vwap

// -------------------------------------------------------- Volume / VSA -------
float volMa = ta.sma(volume, volLen)
float relVol = volMa > 0 ? volume / volMa : 0.0
bool highVol   = relVol >= highVolX
bool climaxVol = relVol >= climaxX
float spread = high - low
float avgSpread = ta.sma(spread, volLen)
bool narrowSpread = not na(avgSpread) and spread < avgSpread
bool upBar   = close > open
bool downBar = close < open
// VSA reads: demand = high-volume up bar; supply = high-volume down bar;
// absorption = climax volume on a narrow spread (effort with no result).
bool vsaDemand = highVol and upBar
bool vsaSupply = highVol and downBar
bool absorption = climaxVol and narrowSpread
bool noDemand = upBar and relVol < 0.7 and narrowSpread     // weak up bar = no buyers
bool noSupply = downBar and relVol < 0.7 and narrowSpread   // weak down bar = no sellers

barcolor(colorVol and climaxVol ? color.new(color.fuchsia, 0) : colorVol and highVol ? color.new(color.aqua, 30) : na)

// Visible VSA markers
plotshape(showVSA and vsaDemand and not climaxVol, "VSA Demand", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny, text = "D")
plotshape(showVSA and vsaSupply and not climaxVol, "VSA Supply", style = shape.triangledown, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny, text = "S")
plotchar(showVSA and climaxVol, "VSA Climax", "◆", location = location.abovebar, color = color.fuchsia, size = size.tiny, text = "CLX")
plotchar(showVSA and absorption, "VSA Absorption", "▣", location = location.belowbar, color = color.yellow, size = size.tiny)
// (No-demand / no-supply markers removed from the price chart to reduce noise;
//  that read still lives in the Volume Analysis pane and the dashboard table.)

// --------------------------------------------------- Premium / Discount ------
bool haveRange = not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow
float eqm = haveRange ? (lastSwingHigh + lastSwingLow) / 2.0 : na
bool inDiscount = haveRange and close < eqm
bool inPremium  = haveRange and close > eqm

// --------------------------------------------------- Confluence scoring ------
// Long confluence
int scoreLong = 0
scoreLong += trend == 1 ? 25 : (chochUp ? 20 : 0)
scoreLong += inDiscount ? 15 : 0
scoreLong += sweepSellSide ? 20 : 0
scoreLong += bullFvgUnmitigated ? 15 : 0
scoreLong += (aboveVwap or vwapReclaimUp) ? 10 : 0
scoreLong += vsaDemand ? 15 : 0
scoreLong := math.min(scoreLong, 100)

// Short confluence
int scoreShort = 0
scoreShort += trend == -1 ? 25 : (chochDn ? 20 : 0)
scoreShort += inPremium ? 15 : 0
scoreShort += sweepBuySide ? 20 : 0
scoreShort += bearFvgUnmitigated ? 15 : 0
scoreShort += (belowVwap or vwapReclaimDn) ? 10 : 0
scoreShort += vsaSupply ? 15 : 0
scoreShort := math.min(scoreShort, 100)

// ------------------------------------------------------- Risk / targets ------
float stopBuf = atrOk ? atr * stopBufX : 0.0
float swLow = na(lastSwingLow)  ? low  : math.min(lastSwingLow, low)
float swHigh = na(lastSwingHigh) ? high : math.max(lastSwingHigh, high)

float slLong = swLow - stopBuf
float tgtLong = (na(lastSwingHigh) or lastSwingHigh <= close) ? close + minRR * (close - slLong) : lastSwingHigh
float rrLong = (close - slLong) > 0 ? (tgtLong - close) / (close - slLong) : 0.0

float slShort = swHigh + stopBuf
float tgtShort = (na(lastSwingLow) or lastSwingLow >= close) ? close - minRR * (slShort - close) : lastSwingLow
float rrShort = (slShort - close) > 0 ? (close - tgtShort) / (slShort - close) : 0.0

// ------------------------------------------------------------ Signals --------
var int lastSigBar = -100000
bool cooldownOk = (bar_index - lastSigBar) > cooldown

bool longSignal = barstate.isconfirmed and scoreLong >= scoreThreshold and rrLong >= minRR and cooldownOk
bool shortSignal = barstate.isconfirmed and scoreShort >= scoreThreshold and rrShort >= minRR and cooldownOk

// If both qualify on the same bar, take the higher score.
if longSignal and shortSignal
    if scoreLong >= scoreShort
        shortSignal := false
    else
        longSignal := false

if longSignal or shortSignal
    lastSigBar := bar_index

plotshape(showSignals and longSignal, "Long", style = shape.triangleup, location = location.belowbar, color = color.new(color.green, 0), size = size.normal, text = "LONG")
plotshape(showSignals and shortSignal, "Short", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.normal, text = "SHORT")

// ---------------------------------------------------------- Webhook JSON -----
f_json(_side, _entry, _sl, _tp, _conf) =>
    '{"secret":"' + whSecret + '","symbol":"' + whSymbol + '","side":"' + _side + '","entry":' + str.tostring(_entry, "#.########") + ',"stopLoss":' + str.tostring(_sl, "#.########") + ',"takeProfit":' + str.tostring(_tp, "#.########") + ',"confluence":' + str.tostring(_conf) + '}'

if showSignals and longSignal
    alert(f_json("long", close, slLong, tgtLong, scoreLong), alert.freq_once_per_bar_close)
if showSignals and shortSignal
    alert(f_json("short", close, slShort, tgtShort, scoreShort), alert.freq_once_per_bar_close)

// alertcondition variants (for manual alert wiring / visibility)
alertcondition(longSignal, "Sniper Long", "Sniper SMC long signal")
alertcondition(shortSignal, "Sniper Short", "Sniper SMC short signal")

// ------------------------------------------------------------- Dashboard -----
var table tbl = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(tbl, 0, 0, "Trend", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Range", text_color = trend == 1 ? color.green : trend == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(tbl, 0, 1, "Zone", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, inDiscount ? "Discount" : inPremium ? "Premium" : "-", text_size = size.small)
    table.cell(tbl, 0, 2, "VWAP", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, aboveVwap ? "Above" : belowVwap ? "Below" : "-", text_size = size.small)
    table.cell(tbl, 0, 3, "Rel Vol", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, str.tostring(relVol, "#.0") + "×", text_color = climaxVol ? color.fuchsia : highVol ? color.aqua : color.gray, text_size = size.small)
    table.cell(tbl, 0, 4, "Long conf", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, str.tostring(scoreLong), text_color = scoreLong >= scoreThreshold ? color.green : color.gray, text_size = size.small)
    table.cell(tbl, 0, 5, "Short conf", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, str.tostring(scoreShort), text_color = scoreShort >= scoreThreshold ? color.red : color.gray, text_size = size.small)
    string vsaTxt = climaxVol ? "Climax" : vsaDemand ? "Demand" : vsaSupply ? "Supply" : noDemand ? "No Demand" : noSupply ? "No Supply" : "-"
    table.cell(tbl, 0, 6, "VSA", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 6, vsaTxt, text_color = climaxVol ? color.fuchsia : vsaDemand ? color.lime : vsaSupply ? color.orange : color.gray, text_size = size.small)
