//@version=5
// =============================================================================
// AI-ETH-trade · Sniper SMC Strategy (backtest version of SniperSMC.pine)
// Same confluence engine, wired into TradingView's Strategy Tester so you get
// real win-rate / profit-factor / trade list. Use Bar Replay to step candles.
// NOTE: SMC signals are discretionary by nature — treat backtest numbers as a
// guide, and always forward-test on paper before trusting them live.
// =============================================================================
strategy("Sniper SMC Strategy", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05, pyramiding = 0,
     process_orders_on_close = true)

// ------------------------------------------------------------------- Inputs --
grpMS   = "Market Structure"
swingLen = input.int(8, "Swing Pivot Length", minval = 2, group = grpMS)

grpLiq  = "Liquidity (EQH / EQL & Sweeps)"
eqTolMult = input.float(0.10, "Equal H/L tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpLiq)

grpFVG  = "Fair Value Gaps"
maxFVG    = input.int(8, "Max FVGs kept per side", minval = 1, maxval = 30, group = grpFVG)

grpVwap = "VWAP"
vwapAnchor = input.string("Daily", "Anchor", options = ["Daily", "Weekly"], group = grpVwap)
bandMult  = input.float(2.0, "Band std-dev multiplier", minval = 0.5, step = 0.5, group = grpVwap)

grpVol  = "Volume / VSA"
volLen    = input.int(20, "Volume average length", minval = 2, group = grpVol)
highVolX  = input.float(1.5, "High-volume threshold (× avg)", step = 0.1, group = grpVol)
climaxX   = input.float(2.5, "Climax-volume threshold (× avg)", step = 0.1, group = grpVol)

grpSig  = "Signals & Risk"
scoreThreshold = input.int(60, "Min confluence to signal (0-100)", minval = 0, maxval = 100, group = grpSig)
minRR    = input.float(2.0, "Min Risk:Reward", minval = 0.5, step = 0.1, group = grpSig)
stopBufX = input.float(0.20, "Stop buffer (× ATR)", step = 0.05, group = grpSig)
cooldown = input.int(5, "Min bars between signals", minval = 0, group = grpSig)
allowLong  = input.bool(true, "Allow longs", group = grpSig)
allowShort = input.bool(true, "Allow shorts", group = grpSig)

// --------------------------------------------------------------- Foundations --
atr = ta.atr(200)
atrOk = not na(atr) and atr > 0

// ------------------------------------------------------ Market structure -----
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var float resistance = na
var bool  resBroken  = true
var float support    = na
var bool  supBroken  = true
var int   trend      = 0

var float prevPH = na
var float prevPL = na
bool eqh = false
bool eql = false

if not na(ph)
    if not na(prevPH) and atrOk and math.abs(ph - prevPH) <= eqTolMult * atr
        eqh := true
    prevPH := ph
    lastSwingHigh := ph
    resistance := ph
    resBroken := false
if not na(pl)
    if not na(prevPL) and atrOk and math.abs(pl - prevPL) <= eqTolMult * atr
        eql := true
    prevPL := pl
    lastSwingLow := pl
    support := pl
    supBroken := false

bool bosUp = false
bool chochUp = false
bool bosDn = false
bool chochDn = false
if not na(resistance) and not resBroken and close > resistance
    resBroken := true
    if trend < 0
        chochUp := true
    else
        bosUp := true
    trend := 1
if not na(support) and not supBroken and close < support
    supBroken := true
    if trend > 0
        chochDn := true
    else
        bosDn := true
    trend := -1

// ---------------------------------------------------- Liquidity sweeps -------
bool sweepBuySide  = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bool sweepSellSide = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow

// -------------------------------------------------------- Fair Value Gaps ----
var array<box> bullFVGs = array.new<box>()
var array<box> bearFVGs = array.new<box>()
bool bullFVG = low > high[2]
bool bearFVG = high < low[2]
if bullFVG
    b = box.new(bar_index - 2, low, bar_index + 20, high[2], border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
    array.push(bullFVGs, b)
    if array.size(bullFVGs) > maxFVG
        box.delete(array.shift(bullFVGs))
if bearFVG
    b = box.new(bar_index - 2, low[2], bar_index + 20, high, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
    array.push(bearFVGs, b)
    if array.size(bearFVGs) > maxFVG
        box.delete(array.shift(bearFVGs))

bool bullFvgUnmitigated = false
if array.size(bullFVGs) > 0
    for i = 0 to array.size(bullFVGs) - 1
        bx = array.get(bullFVGs, i)
        if low <= box.get_top(bx)
            box.set_bgcolor(bx, color.new(color.gray, 90))
        else
            bullFvgUnmitigated := true
bool bearFvgUnmitigated = false
if array.size(bearFVGs) > 0
    for i = 0 to array.size(bearFVGs) - 1
        bx = array.get(bearFVGs, i)
        if high >= box.get_bottom(bx)
            box.set_bgcolor(bx, color.new(color.gray, 90))
        else
            bearFvgUnmitigated := true

// ------------------------------------------------------------------- VWAP ----
anchorTf = vwapAnchor == "Weekly" ? "W" : "D"
bool newPeriod = ta.change(time(anchorTf)) != 0
var float sumPV  = 0.0
var float sumV   = 0.0
var float sumPV2 = 0.0
if newPeriod
    sumPV  := 0.0
    sumV   := 0.0
    sumPV2 := 0.0
src = hlc3
sumPV  += src * volume
sumV   += volume
sumPV2 += src * src * volume
float vwap = sumV > 0 ? sumPV / sumV : na
float variance = sumV > 0 ? math.max(sumPV2 / sumV - vwap * vwap, 0.0) : 0.0
float vdev = math.sqrt(variance)
plot(vwap, "VWAP", color = color.new(color.yellow, 0), linewidth = 2)
plot(vwap + bandMult * vdev, "VWAP Upper", color = color.new(color.yellow, 55))
plot(vwap - bandMult * vdev, "VWAP Lower", color = color.new(color.yellow, 55))
bool vwapReclaimUp = not na(vwap) and ta.crossover(close, vwap)
bool vwapReclaimDn = not na(vwap) and ta.crossunder(close, vwap)
bool aboveVwap = not na(vwap) and close > vwap
bool belowVwap = not na(vwap) and close < vwap

// -------------------------------------------------------- Volume / VSA -------
float volMa = ta.sma(volume, volLen)
float relVol = volMa > 0 ? volume / volMa : 0.0
bool highVol = relVol >= highVolX
bool upBar   = close > open
bool downBar = close < open
bool vsaDemand = highVol and upBar
bool vsaSupply = highVol and downBar

// --------------------------------------------------- Premium / Discount ------
bool haveRange = not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow
float eqm = haveRange ? (lastSwingHigh + lastSwingLow) / 2.0 : na
bool inDiscount = haveRange and close < eqm
bool inPremium  = haveRange and close > eqm

// --------------------------------------------------- Confluence scoring ------
int scoreLong = 0
scoreLong += trend == 1 ? 25 : (chochUp ? 20 : 0)
scoreLong += inDiscount ? 15 : 0
scoreLong += sweepSellSide ? 20 : 0
scoreLong += bullFvgUnmitigated ? 15 : 0
scoreLong += (aboveVwap or vwapReclaimUp) ? 10 : 0
scoreLong += vsaDemand ? 15 : 0
scoreLong := math.min(scoreLong, 100)

int scoreShort = 0
scoreShort += trend == -1 ? 25 : (chochDn ? 20 : 0)
scoreShort += inPremium ? 15 : 0
scoreShort += sweepBuySide ? 20 : 0
scoreShort += bearFvgUnmitigated ? 15 : 0
scoreShort += (belowVwap or vwapReclaimDn) ? 10 : 0
scoreShort += vsaSupply ? 15 : 0
scoreShort := math.min(scoreShort, 100)

// ------------------------------------------------------- Risk / targets ------
float stopBuf = atrOk ? atr * stopBufX : 0.0
float swLow  = na(lastSwingLow)  ? low  : math.min(lastSwingLow, low)
float swHigh = na(lastSwingHigh) ? high : math.max(lastSwingHigh, high)
float slLong = swLow - stopBuf
float tgtLong = (na(lastSwingHigh) or lastSwingHigh <= close) ? close + minRR * (close - slLong) : lastSwingHigh
float rrLong = (close - slLong) > 0 ? (tgtLong - close) / (close - slLong) : 0.0
float slShort = swHigh + stopBuf
float tgtShort = (na(lastSwingLow) or lastSwingLow >= close) ? close - minRR * (slShort - close) : lastSwingLow
float rrShort = (slShort - close) > 0 ? (close - tgtShort) / (slShort - close) : 0.0

// ------------------------------------------------------------ Signals --------
var int lastSigBar = -100000
bool cooldownOk = (bar_index - lastSigBar) > cooldown
bool longSignal  = allowLong  and scoreLong  >= scoreThreshold and rrLong  >= minRR and cooldownOk
bool shortSignal = allowShort and scoreShort >= scoreThreshold and rrShort >= minRR and cooldownOk
if longSignal and shortSignal
    if scoreLong >= scoreShort
        shortSignal := false
    else
        longSignal := false
if longSignal or shortSignal
    lastSigBar := bar_index

// ------------------------------------------------------------ Execution ------
if longSignal
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop = slLong, limit = tgtLong)
if shortSignal
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop = slShort, limit = tgtShort)

plotshape(longSignal, "Long", style = shape.triangleup, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(shortSignal, "Short", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small)
