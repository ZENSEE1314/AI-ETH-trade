//@version=5
// =============================================================================
// AI-ETH-trade · Sniper Volume Analysis (VSA) — separate lower pane
// Stacked volume envelopes (fast/medium/slow EMA) + VSA-coloured volume columns
// + a smoothed volume line, styled like a classic volume-analysis pane.
// Add it and, if it lands on the price chart, right-click its name ->
// "Move to -> New pane below" so it sits in its own window.
// =============================================================================
indicator("Sniper Volume Analysis", overlay = false)

// ------------------------------------------------------------------- Inputs --
fastLen   = input.int(8,  "Fast envelope EMA",   minval = 1)
medLen    = input.int(20, "Medium envelope EMA", minval = 1)
slowLen   = input.int(50, "Slow envelope EMA",   minval = 1)
highVolX  = input.float(1.5, "High-volume threshold (× avg)", step = 0.1)
climaxX   = input.float(2.5, "Climax-volume threshold (× avg)", step = 0.1)
showAreas = input.bool(true, "Show volume envelopes")
showLine  = input.bool(true, "Show volume MA line")

// ------------------------------------------------------------- Envelopes -----
float volFast = ta.ema(volume, fastLen)
float volMed  = ta.ema(volume, medLen)
float volSlow = ta.ema(volume, slowLen)

// Stacked filled areas (each fills down to zero; largest sits behind).
plot(showAreas ? volSlow : na, "Slow envelope",   color = color.new(color.red, 55),    style = plot.style_area)
plot(showAreas ? volMed  : na, "Medium envelope", color = color.new(color.green, 55),   style = plot.style_area)
plot(showAreas ? volFast : na, "Fast envelope",   color = color.new(color.yellow, 55),  style = plot.style_area)

// --------------------------------------------------------- VSA columns -------
float volAvg = ta.sma(volume, medLen)
float relVol = volAvg > 0 ? volume / volAvg : 0.0
bool  isUp   = close >= open
float spread = high - low
float avgSpread = ta.sma(spread, medLen)
bool  narrowSpread = not na(avgSpread) and spread < avgSpread
bool  climax  = relVol >= climaxX
bool  highVol = relVol >= highVolX

// climax=yellow, demand=lime, supply=red, normal=blue (matches the classic look)
color volCol = climax ? color.yellow :
     highVol and isUp ? color.new(color.lime, 0) :
     highVol and not isUp ? color.new(color.red, 0) :
     color.new(color.blue, 15)

plot(volume, "Volume", style = plot.style_columns, color = volCol)
plot(showLine ? volMed : na, "Volume MA", color = color.new(color.white, 0), linewidth = 1)

// VSA event flags along the bottom.
bool absorption = climax and narrowSpread
plotchar(climax, "Climax", "◆", location = location.bottom, color = color.yellow, size = size.tiny)
plotchar(absorption, "Absorption", "▣", location = location.bottom, color = color.orange, size = size.tiny)

// ---------------------------------------------------------- Readout ----------
var table t = table.new(position.top_right, 2, 3, border_width = 1)
if barstate.islast
    t.cell(0, 0, "Rel Vol", text_color = color.gray, text_size = size.small)
    t.cell(1, 0, str.tostring(relVol, "#.0") + "x", text_color = climax ? color.yellow : highVol ? color.lime : color.gray, text_size = size.small)
    string cls = climax ? "Climax" : highVol and isUp ? "Demand" : highVol and not isUp ? "Supply" : isUp ? "Up" : "Down"
    t.cell(0, 1, "Class", text_color = color.gray, text_size = size.small)
    t.cell(1, 1, cls, text_size = size.small)
    t.cell(0, 2, "Absorption", text_color = color.gray, text_size = size.small)
    t.cell(1, 2, absorption ? "YES" : "-", text_color = absorption ? color.orange : color.gray, text_size = size.small)
