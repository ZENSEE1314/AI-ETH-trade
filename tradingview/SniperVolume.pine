//@version=5
// =============================================================================
// AI-ETH-trade · Sniper Volume Analysis (VSA) — separate lower pane
// A dedicated volume histogram colour-coded by Volume Spread Analysis class,
// with a volume moving average and relative-volume reading. Pair it with the
// "Sniper SMC + VWAP + VSA" overlay for the full picture.
// =============================================================================
indicator("Sniper Volume Analysis", overlay = false)

// ------------------------------------------------------------------- Inputs --
volLen   = input.int(20, "Volume MA length", minval = 2)
highVolX = input.float(1.5, "High-volume threshold (× avg)", step = 0.1)
climaxX  = input.float(2.5, "Climax-volume threshold (× avg)", step = 0.1)
showMA   = input.bool(true, "Show volume MA")
showRelV = input.bool(true, "Show relative-volume line")

// --------------------------------------------------------------- Foundations --
float volMa  = ta.sma(volume, volLen)
float relVol = volMa > 0 ? volume / volMa : 0.0
bool  up     = close >= open
float spread = high - low
float avgSpread = ta.sma(spread, volLen)
bool  narrowSpread = not na(avgSpread) and spread < avgSpread

bool climax  = relVol >= climaxX
bool highVol = relVol >= highVolX

// VSA classes:
//  climax  = exhaustion / stopping volume     -> yellow
//  demand  = high-volume up bar               -> lime
//  supply  = high-volume down bar             -> red
//  normal up / down                            -> muted teal / maroon
color volCol = climax ? color.yellow :
     highVol and up ? color.new(color.lime, 0) :
     highVol and not up ? color.new(color.red, 0) :
     up ? color.new(color.teal, 55) : color.new(color.maroon, 55)

plot(volume, "Volume", style = plot.style_columns, color = volCol)
plot(showMA ? volMa : na, "Volume MA", color = color.new(color.orange, 0), linewidth = 2)

// Relative volume as a faint step line on a secondary scale.
plot(showRelV ? relVol : na, "Relative Volume", color = color.new(color.gray, 30), display = display.pane)
hline(highVolX, "High-vol level", color = color.new(color.gray, 60), linestyle = hline.style_dashed)
hline(climaxX, "Climax level", color = color.new(color.orange, 60), linestyle = hline.style_dashed)

// VSA event flags at the bottom of the pane.
bool absorption = climax and narrowSpread
plotchar(climax, "Climax", "◆", location = location.bottom, color = color.yellow, size = size.tiny)
plotchar(absorption, "Absorption", "▣", location = location.bottom, color = color.orange, size = size.tiny)

// Readout table.
var table t = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    t.cell(0, 0, "Rel Vol", text_color = color.gray, text_size = size.small)
    t.cell(1, 0, str.tostring(relVol, "#.0") + "×", text_color = climax ? color.yellow : highVol ? color.lime : color.gray, text_size = size.small)
    t.cell(0, 1, "Class", text_color = color.gray, text_size = size.small)
    string cls = climax ? "Climax" : highVol and up ? "Demand" : highVol and not up ? "Supply" : up ? "Up" : "Down"
    t.cell(1, 1, cls, text_size = size.small)
    t.cell(0, 2, "Spread", text_color = color.gray, text_size = size.small)
    t.cell(1, 2, narrowSpread ? "Narrow" : "Wide", text_size = size.small)
    t.cell(0, 3, "Absorption", text_color = color.gray, text_size = size.small)
    t.cell(1, 3, absorption ? "YES" : "-", text_color = absorption ? color.orange : color.gray, text_size = size.small)
