# ---------------------------------------------------------------------------
# AI-ETH-trade configuration. Copy to .env and fill in. NEVER commit .env.
#   cp env.example .env
# ---------------------------------------------------------------------------

# HTTP port (Railway injects PORT automatically).
PORT=3000

# Trading symbol.
SYMBOL=ETHUSDT

# --- SAFETY: execution mode -------------------------------------------------
# paper = simulated fills only (DEFAULT, cannot touch real funds).
# live  = sends real orders to Bitunix. Requires keys below AND this flag.
TRADING_MODE=paper

# --- Account / risk (percentages are of account equity) ---------------------
ACCOUNT_EQUITY_USDT=1000
LEVERAGE=50
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=8.0
MIN_RISK_REWARD=2.0
# Bot stops opening new trades once this many are open.
MAX_OPEN_POSITIONS=1

# --- Strategy tuning --------------------------------------------------------
# Minimum confluence score (0-100) required to act on a signal.
MIN_CONFLUENCE=60
# Poll interval (ms) for self-analysis of Bitunix klines. 0 disables polling.
ANALYSIS_INTERVAL_MS=60000

# --- TradingView webhook ----------------------------------------------------
# Shared secret that inbound TradingView alerts must include.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Accounts & sessions ----------------------------------------------------
# Signs login sessions and encrypts stored API secrets. MUST be a long, stable
# random string in production, or logins and saved keys reset on every restart.
APP_SECRET=change-me-to-a-long-random-string
# After the first (owner) account is created, further sign-ups need this code.
# Leave blank to allow only the single bootstrap owner account.
REGISTRATION_CODE=
# Where users/settings are stored. On Railway, mount a volume and set
# RAILWAY_VOLUME_MOUNT_PATH (Railway sets it automatically for the volume).
DATA_DIR=data

# --- Bitunix API ------------------------------------------------------------
# Optional seed values. You can instead enter these in the app's Settings page
# (stored encrypted). The Settings page overrides these once saved.
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
