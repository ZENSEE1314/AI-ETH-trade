# ---------------------------------------------------------------------------
# AI-ETH-trade configuration. Copy to .env and fill in. NEVER commit .env.
#   cp env.example .env
# ---------------------------------------------------------------------------

# HTTP port (Railway injects PORT automatically).
PORT=3000

# Trading symbol.
SYMBOL=ETHUSDT

# --- SAFETY: execution mode -------------------------------------------------
# paper = simulated fills only (DEFAULT, cannot touch real funds).
# live  = sends real orders to Bitunix. Requires keys below AND this flag.
TRADING_MODE=paper

# --- Account / risk (percentages are of account equity) ---------------------
ACCOUNT_EQUITY_USDT=1000
LEVERAGE=50
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=8.0
MIN_RISK_REWARD=2.0
# Bot stops opening new trades once this many are open.
MAX_OPEN_POSITIONS=1

# --- Strategy tuning --------------------------------------------------------
# Minimum confluence score (0-100) required to act on a signal.
MIN_CONFLUENCE=60
# Poll interval (ms) for self-analysis of Bitunix klines. 0 disables polling.
ANALYSIS_INTERVAL_MS=60000

# --- TradingView webhook ----------------------------------------------------
# Shared secret that inbound TradingView alerts must include.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Dashboard auth ---------------------------------------------------------
# Basic gate for the dashboard/API. Leave blank to disable (local dev only).
DASHBOARD_TOKEN=

# --- Bitunix API (ONLY needed for TRADING_MODE=live) ------------------------
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
